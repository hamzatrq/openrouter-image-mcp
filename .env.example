OPENROUTER_API_KEY=sk-or-v1-...
# Optional. Defaults to ~/.openrouter-image-mcp/images
IMAGE_OUTPUT_DIR=
# Optional. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
# Optional. Sent as HTTP-Referer to OpenRouter (used for app attribution).
OPENROUTER_HTTP_REFERER=
# Optional. Sent as X-Title to OpenRouter.
OPENROUTER_APP_TITLE=
